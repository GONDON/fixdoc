#!/usr/bin/env bash
# fixdoc post-commit hook
# Activated by `fixdoc init` (sets core.hooksPath = .githooks).
# fail-open: any error must NOT block the commit.

set +e

# Resolve `fixdoc` from PATH; fall back to FIXDOC_BIN env override.
FIXDOC_CMD="${FIXDOC_BIN:-fixdoc}"
if ! command -v "$FIXDOC_CMD" >/dev/null 2>&1; then
  echo "[fixdoc] hook installed but \`$FIXDOC_CMD\` not found on PATH; skipping (commit not blocked)." >&2
  exit 0
fi

"$FIXDOC_CMD" _hook 2>&1 || true
exit 0
